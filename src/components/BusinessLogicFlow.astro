---
// "FROM REQUIREMENT TO SYSTEM" — Demonstrating engineering depth beyond interfaces
const stages = [
  {
    stage: "01",
    role: "INPUT",
    title: "Business Requirement",
    body: "Patients must be able to book doctor appointments without double-booking or time conflicts.",
    footer: "CONTEXT: Healthcare",
    status: "SPECIFIED",
  },
  {
    stage: "02",
    role: "GATEKEEPER",
    title: "Business Rules",
    body: "JWT auth check · Patient role gate · Doctor shift query · Slot collision check · Duplicate lock.",
    footer: "STATE: VALIDATED",
    status: "ENFORCED",
  },
  {
    stage: "03",
    role: "GATEWAY",
    title: "REST API Contract",
    body: "POST /api/appointments · Schema payload validation, sanitization middleware, and error guards.",
    footer: "STATUS: 201 CREATED",
    status: "STRUCTURED",
  },
  {
    stage: "04",
    role: "PERSISTENCE",
    title: "Database Layer",
    body: "Atomic document write in MongoDB referencing PatientID, DoctorID, timestamp, and status.",
    footer: "STORE: MongoDB Mongoose",
    status: "ATOMIC",
  },
  {
    stage: "05",
    role: "ASYNC DISPATCH",
    title: "Side Effects",
    body: "Asynchronous Nodemailer SMTP worker dispatches confirmed booking email receipt to patient.",
    footer: "DISPATCH: QUEUED",
    status: "EMITTED",
  },
  {
    stage: "06",
    role: "OUTCOME",
    title: "Deterministic UX",
    body: "Optimistic UI update, confirmed calendar slot badge, and instant visual feedback without reload.",
    footer: "RESULT: ZERO CONFLICT",
    status: "RESOLVED",
  },
];
---

<section id="systems" class="py-24 md:py-32 bg-theme hairline-b relative overflow-hidden">
  <div class="absolute inset-0 grid-bg-pattern opacity-40 pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-16 pb-6 border-b border-[var(--border)]">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-xs font-mono uppercase tracking-widest text-[var(--accent)] font-semibold">04 / ARCHITECTURAL RIGOR</span>
        <span class="text-[var(--border)]">/</span>
        <span class="text-xs font-mono uppercase tracking-widest text-[var(--text-muted)]">BUSINESS LOGIC</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif text-[var(--text-primary)] tracking-tight mb-4">
        From Requirement to System
      </h2>
      <p class="text-sm sm:text-base text-[var(--text-muted)] font-sans leading-relaxed">
        Software is not merely a collection of UI screens. It is the deterministic execution of business rules, data validations, persistence gates, and transactional side-effects.
      </p>
    </div>

    <!-- Responsive Computational Flow: Grid on Desktop, Vertical Stack on Mobile -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4 font-mono">
      {stages.map((st) => (
        <div class="group p-5 rounded-xl bg-[var(--surface)] border border-[var(--border)] hover:border-[var(--accent)] transition-all duration-200 flex flex-col justify-between shadow-xs">
          <div>
            <div class="flex items-center justify-between text-[10px] text-[var(--text-muted)] mb-3 pb-1 border-b border-[var(--border)]">
              <span>STAGE {st.stage}</span>
              <span class="text-[var(--accent)] font-semibold">{st.role}</span>
            </div>
            
            <h3 class="text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider mb-2 font-mono group-hover:text-[var(--accent)] transition-colors">
              {st.title}
            </h3>

            <p class="text-xs text-[var(--text-muted)] font-sans leading-relaxed">
              {st.body}
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-[var(--border)] flex items-center justify-between text-[10px]">
            <span class="text-[var(--text-muted)]">{st.footer}</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-semibold">{st.status}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Interactive Concept Callout -->
    <div class="mt-10 p-6 rounded-xl bg-[var(--surface-subtle)] border border-[var(--border)] flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
      <div class="flex items-center gap-3">
        <span class="w-2.5 h-2.5 rounded-full bg-[var(--accent)]"></span>
        <span class="text-[var(--text-primary)] font-semibold">LIVE REPRODUCIBILITY: Hospital Management System MERN Repository</span>
      </div>
      <a href="/projects/hospital-management" class="text-[var(--accent)] hover:underline font-semibold flex items-center gap-1 shrink-0">
        <span>View Full Case Study</span> <span>→</span>
      </a>
    </div>

  </div>
</section>
