---
const navLinks = [
  { name: "Work", href: "/#work" },
  { name: "Experience", href: "/#experience" },
  { name: "Systems", href: "/#systems" },
  { name: "SaaS Model", href: "/#saas-architecture" },
  { name: "Skills", href: "/#skills" },
  { name: "Contact", href: "/contact" },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-40 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div id="header-inner" class="flex items-center justify-between h-20 px-3 sm:px-6 transition-all duration-300 rounded-b-2xl border-b border-transparent">
      
      <!-- Brand Logo / Monogram -->
      <a href="/" class="group flex items-center gap-3 focus-visible:outline-none" aria-label="Nabil Shaikh Home">
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-md bg-[var(--surface-subtle)] border border-[var(--border)] text-[var(--text-primary)] flex items-center justify-center font-mono font-bold text-sm sm:text-base tracking-tighter group-hover:border-[var(--accent)] group-hover:text-[var(--accent)] transition-colors duration-200">
          <span>NS</span>
        </div>
        <div class="flex flex-col">
          <span class="text-xs sm:text-sm font-semibold tracking-tight text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors">Nabil Shaikh</span>
          <span class="text-[9px] sm:text-[10px] font-mono text-[var(--text-muted)] tracking-wider uppercase">Full Stack Developer</span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-1 p-1.5 rounded-full bg-[var(--surface)]/80 backdrop-blur-md border border-[var(--border)] shadow-xs" aria-label="Primary Navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="px-3.5 py-1.5 text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-[var(--surface-subtle)] rounded-full transition-all duration-150"
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Right Actions: Socials, Resume, Theme Toggle, Contact -->
      <div class="hidden md:flex items-center gap-3">
        <!-- Resume Link -->
        <a
          href="/resume"
          class="text-xs font-mono text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors px-2.5 py-1.5 rounded-md hover:bg-[var(--surface-subtle)] border border-transparent hover:border-[var(--border)]"
        >
          Resume
        </a>

        <!-- GitHub -->
        <a
          href="https://github.com/itsNabilSk"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-mono text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors p-2 rounded-md hover:bg-[var(--surface-subtle)]"
          aria-label="GitHub Profile"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
        </a>

        <!-- Theme Toggle Button -->
        <button
          id="theme-toggle-btn"
          type="button"
          class="w-9 h-9 rounded-md bg-[var(--surface-subtle)] border border-[var(--border)] text-[var(--text-primary)] hover:text-[var(--accent)] hover:border-[var(--accent)] flex items-center justify-center transition-colors cursor-pointer"
          aria-label="Toggle light and dark theme"
        >
          <!-- Sun Icon (shown in dark mode) -->
          <svg id="sun-icon" class="w-4 h-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
          </svg>
          <!-- Moon Icon (shown in light mode) -->
          <svg id="moon-icon" class="w-4 h-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          </svg>
        </button>

        <!-- Let's Talk CTA -->
        <a
          href="/contact"
          class="px-4 py-2 text-xs font-mono font-semibold bg-[var(--accent)] text-white hover:opacity-90 transition-all duration-200 rounded-md tracking-wider uppercase shadow-xs"
        >
          Let's Talk
        </a>
      </div>

      <!-- Mobile Right Controls (Theme Toggle + Hamburger) -->
      <div class="flex md:hidden items-center gap-2">
        <!-- Mobile Theme Toggle -->
        <button
          id="mobile-theme-toggle-btn"
          type="button"
          class="w-9 h-9 rounded-md bg-[var(--surface-subtle)] border border-[var(--border)] text-[var(--text-primary)] flex items-center justify-center transition-colors cursor-pointer"
          aria-label="Toggle theme"
        >
          <svg class="w-4 h-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
          <svg class="w-4 h-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        </button>

        <!-- Hamburger Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="flex flex-col justify-center items-center w-9 h-9 rounded-md bg-[var(--surface-subtle)] border border-[var(--border)] text-[var(--text-primary)] cursor-pointer"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <span class="w-4 h-0.5 bg-[var(--text-primary)] transition-transform duration-200 -translate-y-1" id="burger-top"></span>
          <span class="w-4 h-0.5 bg-[var(--text-primary)] transition-opacity duration-200" id="burger-mid"></span>
          <span class="w-4 h-0.5 bg-[var(--text-primary)] transition-transform duration-200 translate-y-1" id="burger-bot"></span>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Full-Screen Overlay Navigation -->
  <div
    id="mobile-menu-overlay"
    class="fixed inset-0 top-20 bg-[var(--bg)]/98 backdrop-blur-2xl border-t border-[var(--border)] flex flex-col justify-between p-6 transition-all duration-300 opacity-0 pointer-events-none md:hidden z-30 overflow-y-auto"
  >
    <nav class="flex flex-col gap-4 py-4" aria-label="Mobile Navigation">
      <span class="text-[10px] font-mono uppercase text-[var(--text-muted)] tracking-widest">Navigation</span>
      {navLinks.map((link, idx) => (
        <a
          href={link.href}
          class="mobile-nav-link text-xl font-serif text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors flex items-center justify-between border-b border-[var(--border-subtle)] pb-2.5"
        >
          <span>{link.name}</span>
          <span class="text-xs font-mono text-[var(--text-muted)]">0{idx + 1}</span>
        </a>
      ))}
      <a
        href="/resume"
        class="mobile-nav-link text-xl font-serif text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors flex items-center justify-between border-b border-[var(--border-subtle)] pb-2.5"
      >
        <span>Resume & Experience</span>
        <span class="text-xs font-mono text-[var(--accent)]">PDF/DOC</span>
      </a>
    </nav>

    <div class="flex flex-col gap-4 pt-4 border-t border-[var(--border)]">
      <div class="flex items-center justify-between text-xs font-mono text-[var(--text-muted)]">
        <a href="https://github.com/itsNabilSk" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text-primary)]">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/nabil-shaikh-124a292b8/" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text-primary)]">LinkedIn ↗</a>
        <span>Mumbai, IN</span>
      </div>
      <a
        href="/contact"
        class="w-full text-center py-3 bg-[var(--accent)] text-white font-mono font-semibold text-xs tracking-wider uppercase rounded-md shadow-xs"
      >
        Start a Conversation
      </a>
    </div>
  </div>
</header>

<script>
  // Scroll behavior for navbar
  const headerInner = document.getElementById('header-inner');
  const updateScroll = () => {
    if (!headerInner) return;
    if (window.scrollY > 20) {
      headerInner.classList.add('bg-[var(--bg)]/90', 'backdrop-blur-md', 'border-[var(--border)]', 'shadow-xs', 'py-2');
      headerInner.classList.remove('py-4');
    } else {
      headerInner.classList.remove('bg-[var(--bg)]/90', 'backdrop-blur-md', 'border-[var(--border)]', 'shadow-xs', 'py-2');
      headerInner.classList.add('py-4');
    }
  };
  window.addEventListener('scroll', updateScroll, { passive: true });
  updateScroll();

  // Theme Toggle logic
  const handleToggle = () => {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
  };

  const themeBtn = document.getElementById('theme-toggle-btn');
  const mobileThemeBtn = document.getElementById('mobile-theme-toggle-btn');
  if (themeBtn) themeBtn.addEventListener('click', handleToggle);
  if (mobileThemeBtn) mobileThemeBtn.addEventListener('click', handleToggle);

  // Mobile Menu Toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const overlay = document.getElementById('mobile-menu-overlay');
  const burgerTop = document.getElementById('burger-top');
  const burgerMid = document.getElementById('burger-mid');
  const burgerBot = document.getElementById('burger-bot');
  let menuOpen = false;

  const toggleMenu = () => {
    menuOpen = !menuOpen;
    if (menuBtn && overlay && burgerTop && burgerMid && burgerBot) {
      menuBtn.setAttribute('aria-expanded', String(menuOpen));
      if (menuOpen) {
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        overlay.classList.add('opacity-100', 'pointer-events-auto');
        burgerTop.style.transform = 'rotate(45deg) translate(2px, 2px)';
        burgerMid.style.opacity = '0';
        burgerBot.style.transform = 'rotate(-45deg) translate(2px, -2px)';
        document.body.style.overflow = 'hidden';
      } else {
        overlay.classList.add('opacity-0', 'pointer-events-none');
        overlay.classList.remove('opacity-100', 'pointer-events-auto');
        burgerTop.style.transform = 'translateY(-4px)';
        burgerMid.style.opacity = '1';
        burgerBot.style.transform = 'translateY(4px)';
        document.body.style.overflow = '';
      }
    }
  };

  if (menuBtn) menuBtn.addEventListener('click', toggleMenu);

  const mobileLinks = document.querySelectorAll('.mobile-nav-link');
  mobileLinks.forEach((l) => {
    l.addEventListener('click', () => {
      if (menuOpen) toggleMenu();
    });
  });
</script>
