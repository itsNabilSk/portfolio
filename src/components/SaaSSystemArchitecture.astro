---
// "HOW I THINK ABOUT SAAS" — 9-layer architectural model
const saasLayers = [
  { num: "01", name: "User Client", sub: "Responsive, accessible, fast UI with synchronized state", tech: "React / Astro / Tailwind", details: "Zero layout shift, semantic HTML landmarks, optimistic UI updates, and sub-second load times." },
  { num: "02", name: "Authentication", sub: "Session control & role-based gatekeeping", tech: "JWT / RBAC Middleware", details: "Stateless JSON Web Tokens with expiry enforcement and role-based route guards." },
  { num: "03", name: "Application Core", sub: "Modular routing & state orchestration", tech: "Express / Controllers", details: "Clean MVC boundary separation between controllers, service layers, and data models." },
  { num: "04", name: "Business Logic", sub: "Domain rules & deterministic validation gates", tech: "Deterministic Services", details: "Enforces business rules such as appointment conflict prevention and PII sanitization." },
  { num: "05", name: "API Contracts", sub: "RESTful endpoints & payload specs", tech: "Centralized Validation", details: "Strict schema validation and structured error response payloads with standard HTTP codes." },
  { num: "06", name: "Database Model", sub: "Normalized schemas & document stores", tech: "MongoDB / PostgreSQL", details: "Indexed collections, atomic transactions, and data integrity guarantees." },
  { num: "07", name: "Integrations", sub: "AI pipelines, transactional email, APIs", tech: "Nodemailer / Multer / LLM", details: "Asynchronous background side-effects without blocking user-facing HTTP request threads." },
  { num: "08", name: "Observability", sub: "Structured error logging & monitoring", tech: "Error Handlers / Statuses", details: "Predictable failure handling that logs actionable diagnostics without leaking stack traces." },
  { num: "09", name: "Production & Deploy", sub: "Containerized, automated release", tech: "Docker / Vercel / CI/CD", details: "Reproducible container environments and automated production deployments." },
];
---

<section id="saas-architecture" class="py-24 md:py-32 bg-theme hairline-b">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 pb-6 border-b border-[var(--border)] gap-6">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="text-xs font-mono uppercase tracking-widest text-[var(--accent)] font-semibold">06 / SYSTEM TOPOLOGY</span>
          <span class="text-[var(--border)]">/</span>
          <span class="text-xs font-mono uppercase tracking-widest text-[var(--text-muted)]">SAAS PHILOSOPHY</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif text-[var(--text-primary)] tracking-tight">
          How I Think About SaaS
        </h2>
      </div>
      <p class="text-sm sm:text-base text-[var(--text-muted)] max-w-md font-sans leading-relaxed">
        Building viable SaaS products requires deep architectural discipline across nine core tiers — far beyond basic frontends.
      </p>
    </div>

    <!-- 9-Layer Visual Topology with Interactive Expandable Tabs -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {saasLayers.map((layer) => (
        <div class="layer-card group p-5 rounded-xl bg-[var(--surface)] border border-[var(--border)] hover:border-[var(--accent)] transition-all duration-200 flex flex-col justify-between font-mono cursor-pointer">
          <div>
            <div class="flex items-center justify-between text-xs text-[var(--text-muted)] mb-3 pb-2 border-b border-[var(--border)]">
              <span class="text-[var(--accent)] font-bold font-mono">TIER {layer.num}</span>
              <span class="text-[10px] uppercase text-[var(--text-muted)] tracking-wider">SYSTEM LAYER</span>
            </div>
            
            <h3 class="text-lg font-semibold text-[var(--text-primary)] font-sans mb-1 group-hover:text-[var(--accent)] transition-colors">
              {layer.name}
            </h3>

            <p class="text-xs text-[var(--text-muted)] font-sans leading-relaxed mb-3">
              {layer.sub}
            </p>

            <p class="text-[11px] text-[var(--text-dim)] font-sans leading-relaxed pt-2 border-t border-[var(--border-subtle)]">
              {layer.details}
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-[var(--border)] text-[11px] text-[var(--accent)] font-semibold flex items-center justify-between">
            <span class="text-[var(--text-muted)] text-[10px] uppercase">STACK:</span>
            <span>{layer.tech}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Summary Box -->
    <div class="mt-12 p-8 rounded-2xl bg-[var(--surface-subtle)] border border-[var(--border)] flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-1">
        <div class="text-xs font-mono uppercase text-[var(--accent)] tracking-wider font-semibold">CORE SAAS PRINCIPLE</div>
        <div class="text-xl sm:text-2xl font-serif text-[var(--text-primary)] font-normal">
          "Architecture dictates scalability. Clean contracts prevent logic debt."
        </div>
      </div>
      <div class="shrink-0 flex items-center gap-3">
        <a href="#work" class="px-5 py-2.5 rounded-md bg-[var(--accent)] hover:opacity-90 text-white text-xs font-mono uppercase tracking-wider transition-opacity font-semibold">
          See In Practice
        </a>
      </div>
    </div>

  </div>
</section>
